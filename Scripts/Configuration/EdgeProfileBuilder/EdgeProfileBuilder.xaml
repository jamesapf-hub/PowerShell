<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edge Profile Shortcut Builder v1.0.0"
        Height="780" Width="1120" MinHeight="640" MinWidth="860"
        WindowStartupLocation="Manual"
        Foreground="#F8FAFC">
    <Window.Background>
        <RadialGradientBrush Center="0.5,0.0" GradientOrigin="0.5,0.0" RadiusX="0.95" RadiusY="0.85">
            <GradientStop Color="#0F1F3D" Offset="0.0"/>
            <GradientStop Color="#091122" Offset="0.55"/>
            <GradientStop Color="#05070C" Offset="1.0"/>
        </RadialGradientBrush>
    </Window.Background>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#14FFFFFF"/>
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="BorderBrush" Value="#26354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,7"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#24FFFFFF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2DD4BF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2DD4BF"/>
            <Setter Property="Foreground" Value="#042F2E"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#5EEAD4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#14B8A6"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GenerateButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,9"/>
        </Style>

        <Style x:Key="CardImageButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RemoveCardButton" TargetType="Button">
            <Setter Property="Background" Value="#26EF4444"/>
            <Setter Property="BorderBrush" Value="#66EF4444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FCA5A5"/>
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#45EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#99070D1A"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#26354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="#2DD4BF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#2DD4BF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="EdgeIconCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#99070D1A"/>
            <Setter Property="BorderBrush" Value="#26354D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="#242DD4BF"/>
                    <Setter Property="BorderBrush" Value="#2DD4BF"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <Border Grid.Row="0" Background="#B3070D19" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1" Padding="20,14">
            <DockPanel>
                <Border DockPanel.Dock="Right" Background="#660D192E" BorderBrush="#2DD4BF" BorderThickness="1"
                        CornerRadius="14" Padding="14,5" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtSelectedBadge" Text="0 Selected" Foreground="#2DD4BF" FontWeight="Bold" FontSize="12.5"/>
                </Border>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Edge Profile Shortcut Builder" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC"/>
                        <Border Background="#660D192E" BorderBrush="#26354D" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0.0" FontSize="11" FontWeight="SemiBold" Foreground="#2DD4BF"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Tick icons from the default pack or upload/drop your own images to build isolated Edge profiles and taskbar-pinnable shortcuts."
                               FontSize="12.5" Foreground="#94A3B8" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 1: Action Toolbar -->
        <Border Grid.Row="1" Background="#660D192E" BorderBrush="#26354D" BorderThickness="1" CornerRadius="8" Padding="10" Margin="20,12,20,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="BtnUploadIcons" Content="+ Upload Icons..." Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button x:Name="BtnLoadFolder" Content="Load Folder..." Margin="0,0,8,0"/>
                    <Button x:Name="BtnDefaultPack" Content="Default Pack" Margin="0,0,8,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <TextBlock Text="Drag &amp; drop PNG/JPG/ICO onto grid" Foreground="#94A3B8" FontSize="11.5"
                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Button x:Name="BtnSelectAll" Content="Select All" Margin="0,0,8,0"/>
                    <Button x:Name="BtnClearAll" Content="Clear Selection"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Row 2: Visual Icon Grid -->
        <Border x:Name="DropZoneBorder" Grid.Row="2" Background="#660D192E" BorderBrush="#26354D" BorderThickness="1"
                CornerRadius="8" Padding="8" AllowDrop="True" Margin="20,0,20,10">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="IcIcons">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" VerticalAlignment="Top"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="EdgeIconCard" Margin="6" Padding="8" CornerRadius="8" Style="{StaticResource EdgeIconCardStyle}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="68"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header: Checkbox + Format Badge + Optional Remove -->
                                    <DockPanel Grid.Row="0" Margin="0,0,0,4">
                                        <CheckBox DockPanel.Dock="Left" VerticalAlignment="Center"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                            <Border Background="#99070D1A" BorderBrush="#26354D" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" Margin="0,0,4,0">
                                                <TextBlock Text="{Binding FormatBadge}" FontSize="10" FontWeight="SemiBold" Foreground="#CBD5E1"/>
                                            </Border>
                                            <Button Content="x" Tag="{Binding Id}" Style="{StaticResource RemoveCardButton}"
                                                    Visibility="{Binding IsUploaded, Converter={StaticResource BoolToVis}}"
                                                    ToolTip="Remove uploaded icon" Name="BtnRemoveCard"/>
                                        </StackPanel>
                                    </DockPanel>

                                    <!-- Icon Preview (Clickable to toggle selection) -->
                                    <Button Grid.Row="1" Style="{StaticResource CardImageButton}" Tag="{Binding Id}" Name="BtnToggleCard">
                                        <Image Source="{Binding Thumbnail}" Width="60" Height="60" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Button>

                                    <!-- Source Label -->
                                    <TextBlock Grid.Row="2" Text="{Binding SourceBadge}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                                    <!-- Editable Profile Name -->
                                    <TextBox Grid.Row="3" Text="{Binding ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             HorizontalContentAlignment="Center" ToolTip="Edit profile / shortcut display name"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Row 3: Profile & Output Options -->
        <Border Grid.Row="3" Background="#660D192E" BorderBrush="#26354D" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="20,0,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="PROFILE MODE &amp; SHORTCUT OPTIONS" FontSize="11" FontWeight="Bold" Foreground="#2DD4BF" Margin="0,0,0,6"/>
                    <RadioButton x:Name="RbIsolated" IsChecked="True" Margin="0,0,0,5"
                                 Content="Isolated User-Data-Dir (separate cookies &amp; sessions per icon)"/>
                    <RadioButton x:Name="RbStandard" Margin="0,0,0,8"
                                 Content="Standard Edge Profile Flag (--profile-directory=&quot;Profile X&quot;)"/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkInPrivate" IsChecked="True" Content="Launch in InPrivate (--inprivate)" Margin="0,0,18,0"/>
                        <CheckBox x:Name="ChkDesktop" IsChecked="False" Content="Also copy shortcuts to Desktop"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="OUTPUT ROOT FOLDER (SHORTCUTS, PROFILES &amp; CONVERTEDICONS)" FontSize="11" FontWeight="Bold" Foreground="#2DD4BF" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtOutputRoot" Grid.Column="0" VerticalContentAlignment="Center"/>
                        <Button x:Name="BtnBrowseOutput" Grid.Column="2" Content="Browse..."/>
                    </Grid>
                    <TextBlock Text="Converted .ico files and isolated profiles stay here so pinned shortcuts never break."
                               FontSize="11" Foreground="#94A3B8" Margin="0,5,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Row 4: Log Console -->
        <TextBox x:Name="TxtLog" Grid.Row="4" Height="68" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto" Background="#CC050A14" BorderBrush="#26354D" Foreground="#CBD5E1"
                 FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Margin="20,0,20,12" AcceptsReturn="True"/>

        <!-- Row 5: Footer Buttons -->
        <Border Grid.Row="5" Background="#B3070D19" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="Tip: Right-click any generated shortcut &#x2192; Show more options &#x2192; Pin to taskbar to keep profiles separate."
                           Foreground="#94A3B8" FontSize="11.5" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="0,0,16,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnOpenShortcuts" Content="Open Shortcuts Folder" Margin="0,0,10,0"/>
                    <Button x:Name="BtnGenerate" Content="Generate Shortcuts" Style="{StaticResource GenerateButton}" IsEnabled="False"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
